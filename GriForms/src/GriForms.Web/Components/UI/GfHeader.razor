@* Header halaman: tile ikon bergradien, judul, subjudul, dan slot aksi *@
<header class="@($"relative mb-5 flex flex-wrap items-center gap-3 border-b border-line pb-3 {Class}")">
    @if (Icon is not null)
    {
        <span class="@($"inline-flex size-9 shrink-0 items-center justify-center rounded-lg bg-linear-to-br text-white shadow-sm {GfStyles.Gradient(Variant)}")">
            <GfIcon Icon="@Icon" Size="GfSize.Sm" />
        </span>
    }
    <div class="min-w-0 flex-[1_1_14rem]">
        <h1 class="m-0 text-lg leading-tight font-semibold tracking-tight text-ink">@Title</h1>
        @if (Subtitle is not null)
        {
            <p class="m-0 mt-0.5 text-xs text-muted">@Subtitle</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="flex flex-wrap items-center gap-2">@Actions</div>
    }
    <span class="@($"absolute -bottom-px left-0 h-0.5 w-16 rounded-full bg-linear-to-r {GfStyles.Gradient(Variant)}")" aria-hidden="true"></span>
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public GfVariant Variant { get; set; } = GfVariant.Primary;
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string? Class { get; set; }
}
