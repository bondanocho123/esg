@using GriForms.Application.Abstractions
@using GriForms.Domain.Enums

@inject ITenantSession Session

<nav class="flex min-h-full flex-col gap-0.5 py-3">
    <p class="mx-5 mt-0 mb-1 text-[10px] font-semibold tracking-wider text-forest-icon/70 uppercase">Menu</p>
    @if (Session.Current.UserId is not null && Session.Current.TenantId is null)
    {
        @* Tanpa organisasi aktif tidak ada menu data tenant; PlatformAdmin hanya melihat menu Platform di bawah *@
        @if (!Session.Current.IsPlatformAdmin)
        {
            <GfNavLink Href="tanpa-organisasi" Icon="@Icons.Material.Filled.Info">Organisasi</GfNavLink>
        }
    }
    else
    {
        <GfNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Beranda</GfNavLink>

        @* Pelaporan: satu tautan per tugas sesuai peran di tenant aktif; hak per site tetap diperiksa layanan *@
        @if (Session.Current.Roles.Count > 0)
        {
            <p class="mx-5 mt-4 mb-1 text-[10px] font-semibold tracking-wider text-forest-icon/70 uppercase">Pelaporan</p>
            @if (Session.Current.Has(RoleName.Contributor))
            {
                <GfNavLink Href="pelaporan/isi" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.EditNote">Isi form</GfNavLink>
            }
            @if (Session.Current.Has(RoleName.Reviewer))
            {
                <GfNavLink Href="pelaporan/tinjau" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.FactCheck">Tinjau form</GfNavLink>
            }
            @if (Session.Current.Has(RoleName.Approver))
            {
                <GfNavLink Href="pelaporan/setujui" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Verified">Setujui form</GfNavLink>
            }
            <GfNavLink Href="pelaporan" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Assignment">Semua form</GfNavLink>
        }

        @if (Session.Current.TenantId is not null)
        {
            <GfNavLink Href="telemetry" Icon="@Icons.Material.Filled.Thermostat">Telemetry</GfNavLink>
        }

        @if (Session.Current.IsTenantAdmin)
        {
            <p class="mx-5 mt-4 mb-1 text-[10px] font-semibold tracking-wider text-forest-icon/70 uppercase">Admin organisasi</p>
            <GfNavLink Href="periode-pelaporan" Icon="@Icons.Material.Filled.Event">Periode pelaporan</GfNavLink>
            <GfNavLink Href="pengaturan-organisasi" Icon="@Icons.Material.Filled.Settings">Pengaturan Organisasi</GfNavLink>
        }
    }

    @if (Session.Current.IsPlatformAdmin)
    {
        <p class="mx-5 mt-4 mb-1 text-[10px] font-semibold tracking-wider text-forest-icon/70 uppercase">Platform</p>
        <GfNavLink Href="organisasi" Icon="@Icons.Material.Filled.Domain">Organisasi</GfNavLink>
        <GfNavLink Href="definisi-form" Icon="@Icons.Material.Filled.Description">Definisi form</GfNavLink>
        <GfNavLink Href="ui-kit" Icon="@Icons.Material.Filled.Palette">UI Kit</GfNavLink>
    }

    <p class="mx-5 mt-4 mb-1 text-[10px] font-semibold tracking-wider text-forest-icon/70 uppercase">Akun</p>
    <AuthorizeView>
        <Authorized>
            <GfNavLink Href="Account/Manage" Icon="@Icons.Material.Filled.Person">@context.User.Identity?.Name</GfNavLink>
        </Authorized>
        <NotAuthorized>
            @* Pendaftaran mandiri dimatikan: akun dibuat oleh admin *@
            <GfNavLink Href="Account/Login" Icon="@Icons.Material.Filled.Login">Login</GfNavLink>
        </NotAuthorized>
    </AuthorizeView>

    <div class="mx-3 mt-auto rounded-lg bg-white/5 p-3 ring-1 ring-white/10">
        <div class="flex items-center gap-2 text-xs font-semibold text-on-forest">
            <GfIcon Icon="@Icons.Material.Filled.Forest" Size="GfSize.Sm" Class="text-sprout" />
            Pelaporan GRI
        </div>
        <p class="m-0 mt-1 text-[11px] leading-snug text-on-forest/60">Data lingkungan, sosial &amp; tata kelola dalam satu tempat.</p>
    </div>

    @* Logout di dasar sidebar *@
    <AuthorizeView>
        <div class="mx-3 mt-2 border-t border-white/10 pt-2">
            <LogoutButton Class="flex h-8 w-full cursor-pointer items-center justify-start gap-2.5 rounded-md border-0 bg-transparent px-3 text-left text-xs font-medium text-on-forest/80 transition hover:bg-white/5 hover:text-on-forest">
                <GfIcon Icon="@Icons.Material.Filled.Logout" Size="GfSize.Sm" Class="text-forest-icon" />
                Logout
            </LogoutButton>
        </div>
    </AuthorizeView>
</nav>
