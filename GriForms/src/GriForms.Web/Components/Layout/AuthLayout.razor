@inherits LayoutComponentBase

@* Layout halaman login dan alur sebelum login: tanpa header, sidebar, dan menu. Isi halaman tampil sebagai kartu di tengah. *@

<MudThemeProvider Theme="GriFormsTheme.Default" />

<main class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden bg-canvas bg-[radial-gradient(50rem_24rem_at_100%_0%,rgba(56,189,248,0.16),transparent),radial-gradient(44rem_24rem_at_0%_100%,rgba(34,197,94,0.18),transparent)] px-4 py-10">
    <div class="absolute top-3 right-3 rounded-full bg-forest-deep/90 p-0.5 shadow-sm">
        <ThemeToggle />
    </div>

    <div class="w-full max-w-sm">
        <a href="" class="mb-5 flex flex-col items-center gap-2 text-center text-ink no-underline hover:text-ink hover:no-underline">
            <img src="logo.png" alt="" class="h-16 w-auto" />
            <span class="text-base font-semibold tracking-tight">Global Report Initiative</span>
            <span class="-mt-1.5 text-xs text-muted">Pelaporan ESG berbasis standar GRI</span>
        </a>

        <section class="overflow-hidden rounded-xl border border-line bg-surface shadow-lg shadow-primary/10">
            <div class="h-1 bg-linear-to-r from-primary-dark via-primary to-secondary" aria-hidden="true"></div>
            <div class="p-6">
                @Body
            </div>
        </section>

        <p class="mt-4 text-center text-[11px] text-muted">&copy; @DateTime.Now.Year Global Report Initiative</p>
    </div>
</main>

<div id="blazor-error-ui" data-nosnippet
     class="fixed inset-x-0 bottom-0 z-50 hidden bg-secondary-light px-5 py-2.5 text-xs text-on-secondary shadow-[0_-1px_2px_rgba(0,0,0,0.2)]">
    An unhandled error has occurred.
    <a href="." class="reload font-semibold">Reload</a>
    <span class="dismiss absolute top-2 right-3 cursor-pointer">🗙</span>
</div>
