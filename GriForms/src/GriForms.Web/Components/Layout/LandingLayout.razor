@inherits LayoutComponentBase

@* Halaman publik: tanpa sidebar aplikasi. Header tetap gelap agar sakelar tema sama dengan layout utama. *@

<MudThemeProvider Theme="GriFormsTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="flex min-h-screen flex-col bg-canvas text-ink">
    <header class="sticky top-0 z-40 border-b border-white/10 bg-forest-deep/95 text-white shadow-md shadow-forest/20 backdrop-blur">
        <div class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-4 sm:px-6">
            <a href="" class="flex min-w-0 items-center gap-2 text-white no-underline hover:text-white hover:no-underline">
                <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-lg bg-white/10 ring-1 ring-white/15">
                    <GfIcon Icon="@Icons.Material.Filled.EnergySavingsLeaf" Size="GfSize.Sm" Class="text-sprout" />
                </span>
                <span class="truncate text-sm font-semibold tracking-tight">
                    <span class="sm:hidden">GRI</span>
                    <span class="hidden sm:inline">Global Report Initiative</span>
                </span>
                <span class="hidden rounded-full bg-sprout/20 px-1.5 py-0.5 text-[10px] leading-none font-semibold text-sprout sm:inline">ESG</span>
            </a>

            <nav class="ml-4 hidden items-center gap-1 md:flex" aria-label="Bagian halaman">
                <a href="#fitur" class="rounded-md px-2.5 py-1 text-xs font-medium text-on-forest/80 no-underline hover:bg-white/10 hover:text-white hover:no-underline">Fitur</a>
                <a href="#alur" class="rounded-md px-2.5 py-1 text-xs font-medium text-on-forest/80 no-underline hover:bg-white/10 hover:text-white hover:no-underline">Alur</a>
                <a href="#peran" class="rounded-md px-2.5 py-1 text-xs font-medium text-on-forest/80 no-underline hover:bg-white/10 hover:text-white hover:no-underline">Peran</a>
            </nav>

            <div class="ml-auto flex items-center gap-2">
                <ThemeToggle />
                <AuthorizeView>
                    <Authorized>
                        <a href="pelaporan"
                           class="inline-flex h-8 items-center rounded-md bg-sprout px-3 text-xs font-semibold text-forest-deep no-underline hover:bg-sprout/90 hover:text-forest-deep hover:no-underline">
                            <span class="sm:hidden">Pelaporan</span>
                            <span class="hidden sm:inline">Buka pelaporan</span>
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="Account/Login"
                           class="inline-flex h-8 items-center rounded-md bg-white/10 px-3 text-xs font-semibold text-white no-underline ring-1 ring-white/15 hover:bg-white/15 hover:text-white hover:no-underline">
                            Masuk
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <nav class="flex gap-1 border-t border-white/10 px-4 py-1.5 md:hidden" aria-label="Bagian halaman">
            <a href="#fitur" class="rounded-md px-2 py-1 text-[11px] font-medium text-on-forest/80 no-underline hover:bg-white/10 hover:text-white hover:no-underline">Fitur</a>
            <a href="#alur" class="rounded-md px-2 py-1 text-[11px] font-medium text-on-forest/80 no-underline hover:bg-white/10 hover:text-white hover:no-underline">Alur</a>
            <a href="#peran" class="rounded-md px-2 py-1 text-[11px] font-medium text-on-forest/80 no-underline hover:bg-white/10 hover:text-white hover:no-underline">Peran</a>
        </nav>
    </header>

    <main class="flex-1">
        @Body
    </main>

    <footer class="border-t border-white/10 bg-forest text-on-forest">
        <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-6 sm:flex-row sm:items-center sm:justify-between sm:px-6">
            <div class="flex items-center gap-2 text-xs font-semibold">
                <GfIcon Icon="@Icons.Material.Filled.Forest" Size="GfSize.Sm" Class="text-sprout" />
                Global Report Initiative
            </div>
            <p class="m-0 text-[11px] text-on-forest/60">&copy; @DateTime.Now.Year Pelaporan lingkungan, sosial, dan tata kelola.</p>
            <AuthorizeView>
                <Authorized>
                    <a href="pelaporan" class="text-xs font-medium text-sprout no-underline hover:text-sprout hover:underline">Ke pelaporan</a>
                </Authorized>
                <NotAuthorized>
                    <a href="Account/Login" class="text-xs font-medium text-sprout no-underline hover:text-sprout hover:underline">Masuk</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet
     class="fixed inset-x-0 bottom-0 z-50 hidden bg-secondary-light px-5 py-2.5 text-xs text-on-secondary shadow-[0_-1px_2px_rgba(0,0,0,0.2)]">
    An unhandled error has occurred.
    <a href="." class="reload font-semibold">Reload</a>
    <span class="dismiss absolute top-2 right-3 cursor-pointer">🗙</span>
</div>
