@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using GriForms.Web.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

@* Tidak ada layanan login eksternal yang dikonfigurasi: bagian ini tidak ditampilkan *@
@if (externalLogins.Length > 0)
{
    <form action="Account/PerformExternalLogin" method="post" class="mt-3 flex flex-col gap-2">
        <AntiforgeryToken />
        <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
        @foreach (var provider in externalLogins)
        {
            <button type="submit" class="w-full btn btn-lg btn-outline-primary" name="provider" value="@provider.Name" title="Masuk dengan akun @provider.DisplayName">Masuk dengan @provider.DisplayName</button>
        }
    </form>
}

@code {
    private AuthenticationScheme[] externalLogins = [];

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
    }
}
