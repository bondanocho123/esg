<StatusMessage Message="@StatusMessage" />
<GfCard Title="Kode pemulihan" Icon="@Icons.Material.Filled.Key" Variant="GfVariant.Tertiary">
    <div class="alert alert-warning" role="alert">
        <strong>Simpan kode ini di tempat aman.</strong>
        Jika perangkat hilang dan kode pemulihan tidak ada, Anda kehilangan akses ke akun.
    </div>
    <div class="grid max-w-md grid-cols-2 gap-2 sm:grid-cols-3">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <code class="rounded-gf border border-line bg-canvas px-2 py-1 text-center font-mono text-xs text-ink">@recoveryCode</code>
        }
    </div>
</GfCard>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
