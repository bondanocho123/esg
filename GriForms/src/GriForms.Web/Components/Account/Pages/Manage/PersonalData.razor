@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using GriForms.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Data pribadi</PageTitle>

<StatusMessage />
<GfCard Title="Data pribadi" Icon="@Icons.Material.Filled.Shield">
    <GfText Typo="Typo.body2" Muted="true" GutterBottom="true">
        Akun Anda menyimpan data pribadi yang Anda berikan. Di sini Anda bisa mengunduh atau menghapus data tersebut.
    </GfText>
    <div class="mt-3 flex flex-wrap items-center gap-2">
        <form action="Account/Manage/DownloadPersonalData" method="post" class="inline-flex">
            <AntiforgeryToken />
            <GfButton Type="submit" StartIcon="@Icons.Material.Filled.Download">Unduh data</GfButton>
        </form>
    </div>
</GfCard>
<GfCard Title="Hapus akun" Icon="@Icons.Material.Filled.DeleteForever" Variant="GfVariant.Tertiary">
    <p class="text-xs text-muted">Menghapus data akan menghapus akun Anda secara permanen dan tidak bisa dipulihkan.</p>
    <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Hapus akun</a>
</GfCard>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
