@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity
@using GriForms.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Verifikasi dua langkah</PageTitle>

<StatusMessage />
<GfCard Title="Verifikasi dua langkah (2FA)" Icon="@Icons.Material.Filled.Security">
    @if (canTrack)
    {
        <div class="mb-3 flex items-center gap-2">
            <span class="text-xs text-muted">Status:</span>
            @if (is2faEnabled)
            {
                <GfChip Variant="GfVariant.Primary">Aktif</GfChip>
            }
            else
            {
                <GfChip Variant="GfVariant.Tertiary">Belum aktif</GfChip>
            }
        </div>

        if (is2faEnabled)
        {
            if (recoveryCodesLeft == 0)
            {
                <div class="alert alert-danger" role="alert">
                    <strong>Kode pemulihan sudah habis.</strong>
                    Anda harus <a href="Account/Manage/GenerateRecoveryCodes">membuat kode pemulihan baru</a> sebelum bisa masuk dengan kode pemulihan.
                </div>
            }
            else if (recoveryCodesLeft == 1)
            {
                <div class="alert alert-danger" role="alert">
                    <strong>Tersisa 1 kode pemulihan.</strong>
                    Sebaiknya <a href="Account/Manage/GenerateRecoveryCodes">buat kode pemulihan baru</a>.
                </div>
            }
            else if (recoveryCodesLeft <= 3)
            {
                <div class="alert alert-warning" role="alert">
                    <strong>Tersisa @recoveryCodesLeft kode pemulihan.</strong>
                    Sebaiknya <a href="Account/Manage/GenerateRecoveryCodes">buat kode pemulihan baru</a>.
                </div>
            }

            <div class="mb-4 flex flex-wrap items-center gap-2">
                @if (isMachineRemembered)
                {
                    <form class="inline-flex" @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                        <AntiforgeryToken />
                        <GfButton Type="submit" Appearance="GfAppearance.Outlined" StartIcon="@Icons.Material.Filled.DevicesOther">Lupakan browser ini</GfButton>
                    </form>
                }
                <GfButton Href="Account/Manage/GenerateRecoveryCodes" Appearance="GfAppearance.Outlined" StartIcon="@Icons.Material.Filled.Key">Buat ulang kode pemulihan</GfButton>
                <GfButton Href="Account/Manage/Disable2fa" Variant="GfVariant.Tertiary" Appearance="GfAppearance.Outlined" StartIcon="@Icons.Material.Filled.Block">Nonaktifkan 2FA</GfButton>
            </div>
        }

        <h3 class="mt-1 border-t border-line pt-3 text-xs font-semibold text-ink">Aplikasi autentikator</h3>
        <div class="flex flex-wrap items-center gap-2">
            @if (!hasAuthenticator)
            {
                <GfButton Href="Account/Manage/EnableAuthenticator" StartIcon="@Icons.Material.Filled.Add">Tambah aplikasi autentikator</GfButton>
            }
            else
            {
                <GfButton Href="Account/Manage/EnableAuthenticator" StartIcon="@Icons.Material.Filled.Settings">Atur aplikasi autentikator</GfButton>
                <GfButton Href="Account/Manage/ResetAuthenticator" Variant="GfVariant.Tertiary" Appearance="GfAppearance.Outlined" StartIcon="@Icons.Material.Filled.RestartAlt">Atur ulang autentikator</GfButton>
            }
        </div>
    }
    else
    {
        <div class="alert alert-danger m-0" role="alert">
            <strong>Kebijakan privasi dan cookie belum disetujui.</strong>
            Setujui kebijakan tersebut sebelum mengaktifkan verifikasi dua langkah.
        </div>
    }
</GfCard>

@code {
    private bool canTrack;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            "Browser ini sudah dilupakan. Saat login lagi dari browser ini, Anda akan diminta kode 2FA.",
            HttpContext);
    }
}
