@page "/Account/Manage/ChangePassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using GriForms.Application.Abstractions
@using GriForms.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject IUserProfiles Profiles
@inject ILogger<ChangePassword> Logger

<PageTitle>Ganti kata sandi</PageTitle>

@if (mustChange)
{
    <div class="alert alert-warning" role="alert">
        Akun ini dibuat oleh admin dengan kata sandi awal. Ganti kata sandi dulu sebelum memakai aplikasi.
    </div>
}
<StatusMessage Message="@message" />
<GfCard Title="Ganti kata sandi" Icon="@Icons.Material.Filled.Password">
    <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post" class="max-w-md">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label for="Input.OldPassword" class="form-label">Kata sandi saat ini</label>
            <InputText type="password" @bind-Value="Input.OldPassword" id="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" />
            <ValidationMessage For="() => Input.OldPassword" class="text-danger" />
        </div>
        <div class="mb-3">
            <label for="Input.NewPassword" class="form-label">Kata sandi baru</label>
            <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" />
            <ValidationMessage For="() => Input.NewPassword" class="text-danger" />
        </div>
        <div class="mb-4">
            <label for="Input.ConfirmPassword" class="form-label">Konfirmasi kata sandi baru</label>
            <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
            <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
        </div>
        <GfButton Type="submit" StartIcon="@Icons.Material.Filled.Save">Simpan kata sandi</GfButton>
    </EditForm>
</GfCard>

@code {
    private string? message;
    private ApplicationUser? user;
    private bool hasPassword;
    private bool mustChange;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        hasPassword = await UserManager.HasPasswordAsync(user);
        if (!hasPassword)
        {
            RedirectManager.RedirectTo("Account/Manage/SetPassword");
            return;
        }

        mustChange = await Profiles.MustChangePasswordAsync(user.Id, HttpContext.RequestAborted);
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        // Kata sandi lama sudah diverifikasi ChangePasswordAsync, jadi cukup membandingkan input
        if (Input.NewPassword == Input.OldPassword)
        {
            message = "Error: Kata sandi baru harus berbeda dari kata sandi lama.";
            return;
        }

        // Gagal di sini tidak menyentuh flag wajib ganti kata sandi
        var changePasswordResult = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!changePasswordResult.Succeeded)
        {
            message = $"Error: {string.Join(",", changePasswordResult.Errors.Select(error => error.Description))}";
            return;
        }

        await Profiles.CompletePasswordChangeAsync(user.Id, HttpContext.RequestAborted);
        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("User changed their password successfully.");

        if (mustChange)
        {
            // Halaman utama: TenantMiddleware meneruskan PlatformAdmin tanpa keanggotaan ke halaman Organisasi
            RedirectManager.RedirectTo("");
            return;
        }

        RedirectManager.RedirectToCurrentPageWithStatus("Kata sandi berhasil diganti.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Kata sandi saat ini wajib diisi.")]
        [DataType(DataType.Password)]
        [Display(Name = "Kata sandi saat ini")]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Kata sandi baru wajib diisi.")]
        [StringLength(100, ErrorMessage = "Kata sandi minimal {2} dan maksimal {1} karakter.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "Kata sandi baru")]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Konfirmasi kata sandi baru")]
        [Compare("NewPassword", ErrorMessage = "Konfirmasi kata sandi tidak sama.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
