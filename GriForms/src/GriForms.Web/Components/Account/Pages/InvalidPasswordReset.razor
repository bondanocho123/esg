@page "/Account/InvalidPasswordReset"
@layout GriForms.Web.Components.Layout.AuthLayout

<PageTitle>Tautan tidak valid</PageTitle>

<h1 class="mb-4 text-center text-lg">Tautan tidak valid</h1>

<div class="alert alert-danger" role="alert">Tautan atur ulang kata sandi tidak valid atau sudah kedaluwarsa.</div>
<a href="Account/ForgotPassword" class="w-full btn btn-lg btn-primary">Minta tautan baru</a>
<p class="mt-5 mb-0 text-center text-[11px] text-muted"><a href="Account/Login">Kembali ke halaman masuk</a></p>
