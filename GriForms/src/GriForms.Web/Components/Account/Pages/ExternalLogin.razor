@page "/Account/ExternalLogin"

@using Microsoft.AspNetCore.Identity
@using GriForms.Web.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ExternalLogin> Logger

<PageTitle>External login</PageTitle>

@code {
    public const string LoginCallbackAction = "LoginCallback";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? RemoteError { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Action { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (RemoteError is not null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", $"Error from external provider: {RemoteError}", HttpContext);
            return;
        }

        var info = await SignInManager.GetExternalLoginInfoAsync();
        if (info is null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", "Error loading external login information.", HttpContext);
            return;
        }

        // Halaman ini hanya dicapai lewat callback login eksternal
        if (!HttpMethods.IsGet(HttpContext.Request.Method) || Action != LoginCallbackAction)
        {
            RedirectManager.RedirectTo("Account/Login");
            return;
        }

        // Sign in the user with this external login provider if the user already has a login.
        var result = await SignInManager.ExternalLoginSignInAsync(
            info.LoginProvider,
            info.ProviderKey,
            isPersistent: false,
            bypassTwoFactor: true);

        if (result.Succeeded)
        {
            Logger.LogInformation(
                "{Name} logged in with {LoginProvider} provider.",
                info.Principal.Identity?.Name,
                info.LoginProvider);
            RedirectManager.RedirectTo(ReturnUrl);
            return;
        }

        if (result.IsLockedOut)
        {
            RedirectManager.RedirectTo("Account/Lockout");
            return;
        }

        // Pendaftaran mandiri dimatikan: login eksternal yang belum terhubung tidak membuat akun baru.
        // Akun dibuat admin; login eksternal bisa dihubungkan dari halaman akun setelah masuk.
        Logger.LogWarning("Login {LoginProvider} ditolak: belum terhubung ke akun yang ada", info.LoginProvider);
        RedirectManager.RedirectToWithStatus(
            "Account/Login",
            "Error: Login eksternal ini belum terhubung ke akun. Akun dibuat oleh admin; masuk dengan email dan kata sandi lalu hubungkan dari halaman akun.",
            HttpContext);
    }
}
